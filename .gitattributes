# Normalizza i line ending: LF nel repo, conversione automatica al checkout
* text=auto

# File di testo sempre LF
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.csv   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Script shell sempre LF (altrimenti si rompono)
*.sh    text eol=lf

# File binari: nessuna conversione
*.zip   binary
*.db    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
