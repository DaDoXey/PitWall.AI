# ── API Keys ───────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
# (OPENAI_API_KEY rimosso: nessun modulo attivo usa OpenAI — residuo storico v2.)

# ── Modello LLM ─────────────────────────────────────
# Modello Anthropic usato da agent.py (analisi + chat). Default: claude-haiku-4-5.
LLM_MODEL=claude-haiku-4-5

# ── Database ────────────────────────────────────────
PITWALL_DB_PATH=./pitwall_sessions.db

# ── Log di runtime (separati dalla documentazione d'esame) ──
# agent.py fa append di prompt/incident. Puntandoli in runtime_logs/ (gitignored)
# le chiamate API NON sporcano i PROMPT_LOG.md / INCIDENTS.md versionati per l'esame.
PITWALL_PROMPT_LOG_PATH=./runtime_logs/prompt_log_runtime.md
PITWALL_INCIDENTS_PATH=./runtime_logs/incidents_runtime.md

# ── Limiti Token API ────────────────────────────────
# Token massimi per la risposta del modello (output)
PITWALL_MAX_OUTPUT_TOKENS=4000
# Token massimi stimati per il contesto (input) prima di mostrare warning
PITWALL_MAX_INPUT_TOKENS=8000
# Token massimi per la risposta della chat "Gigi" (più corta dell'analisi). Default: 800.
PITWALL_CHAT_MAX_TOKENS=800

# ── Live-mode (protezione API key) ──────────────────
# 0 (default) = deploy pubblico: demo-mode forzata, nessuna chiamata LLM da estranei.
# 1 = abilita il toggle Demo-mode e la LLM reale (locale / demo d'esame con secrets).
PITWALL_ALLOW_LIVE=0
# Default della demo-mode quando la live è consentita (ALLOW_LIVE=1); ignorato se live OFF.
PITWALL_DEMO_MODE=1

# ── Feature-flag UI ─────────────────────────────────
# Mostra selettori auto/pista + upload nel Setup (0 = nascosti).
PITWALL_SHOW_INPUTS=0
# Abilita la lettura setup da screenshot via vision (0 = stub, altrimenti richiede API key).
FEATURE_SCREENSHOT=0

# ── Auth ────────────────────────────────────────────
STREAMLIT_ENV=dev  # 'dev' per mock auth, 'prod' per Google OAuth
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
