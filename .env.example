# ── API Keys ───────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Database ────────────────────────────────────────
PITWALL_DB_PATH=./pitwall_sessions.db

# ── Limiti Token API ────────────────────────────────
# Token massimi per la risposta del modello (output)
PITWALL_MAX_OUTPUT_TOKENS=2048
# Token massimi stimati per il contesto (input) prima di mostrare warning
PITWALL_MAX_INPUT_TOKENS=8000
